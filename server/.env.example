# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/campusfind?retryWrites=true&w=majority

# Optional: Cloudinary for cloud image storage (Recommended for Render/Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Visual Matching Service URL (optional)
AI_SERVICE_URL=http://localhost:5001

# Database Seeding
SEED_SAMPLE_ITEMS=false

